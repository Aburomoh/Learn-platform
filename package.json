{
  "name": "cet-learn-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive course companion for CET courses (Learning Shell, Learning Stage, Interaction Engine, rule-based Tutor).",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "wake": "node scripts/wake.mjs",
    "alarm": "node scripts/wake.mjs --alarm",
    "wake:watch": "node scripts/wake.mjs --watch",
    "wake:ack": "node scripts/wake.mjs --ack",
    "wake:pending": "node scripts/wake.mjs --pending"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^28.1.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
